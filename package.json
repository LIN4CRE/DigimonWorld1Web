    "generate:assets": "node generate-github-assets.mjs",
    "analyze:disc": "node analyze-ps1-disc.mjs",
    "analyze:sles": "node analyze-sles-and-data.mjs",
    "extract:data": "node extract-game-data.mjs",
    "extract:assets": "node extract-hd-assets.mjs",
    "build:db": "node build-reverse-engineered-db.mjs",
