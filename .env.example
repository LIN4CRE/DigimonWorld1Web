# DigimonWorld1Web — environment configuration (copy to .env and edit)
# The app reads these from the process environment; no dotenv loader is bundled.
# Export them in your shell, or use `node --env-file=.env server.mjs` (Node 20.6+).
# None of these are secrets. NEVER put real credentials in this file.

# --- Local preview / development server (server.mjs) ---
# Port for the local HTTP server (default 3456).
PORT=3456
# Optional path to a European SLES-02914 disc ZIP served at /rom/Digimon World (Europe).zip
# when rom/Digimon World (Europe).zip is absent.
# DIGIMON_ROM_ZIP=/path/to/Digimon World (Europe).zip

# --- ROM reverse-engineering tooling (optional overrides) ---
# All default to repo-relative paths; set these only if your disc image lives elsewhere.
# DIGIMON_ROM_BIN=/path/to/Digimon World (Europe).bin
# DIGIMON_EXTRACTED_DIR=/path/to/extracted
# DIGIMON_PUBLIC_DIR=/path/to/public
